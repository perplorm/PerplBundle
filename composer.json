{
    "name": "perplorm/perpl-bundle",
    "description": "Integration of Propel and Perpl in Symfony",
    "keywords": ["perpl", "propel", "orm", "persistence"],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://perplorm.github.io",
    "support": {
        "issues": "https://github.com/perplorm/PerplBundle/issues",
        "source": "https://github.com/perplorm/PerplBundle"
    },
    "authors": [
        {
            "name": "Sam Hauglustaine",
            "role": "Maintainer"
        },
        {
            "name": "PerplBundle contributors",
            "homepage": "https://github.com/perplorm/PerplBundle/graphs/contributors"
        },
        {
            "name": "William Durand",
            "role": "Original author of PropelBundle"
        }
    ],
    "conflict": {
        "perplorm/perpl": "<2.10"
    },
    "autoload": {
        "psr-4": { "Propel\\Bundle\\PropelBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Propel\\Bundle\\PropelBundle\\Tests\\": "tests/" }
    },
    "require": {
        "php": ">=8.2",
        "propel/propel": "^2.0.0-beta4||dev-main",
        "symfony/console": "^7.4||^8.0",
        "symfony/dependency-injection": "^7.4||^8.0",
        "symfony/deprecation-contracts": "^3.0",
        "symfony/framework-bundle": "^7.4||^8.0",
        "symfony/security-bundle": "^7.4||^8.0",
        "symfony/yaml": "^7.4||^8.0"
    },
    "require-dev": {
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-pdo": "*",
        "perplorm/perpl": "^2.10",
        "phpunit/phpunit": "^11.5||^12.0",
        "symfony/form": "^7.4||^8.0",
        "fakerphp/faker": "*",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "twig/twig": "*",
        "symfony/stopwatch": "^7.4||^8.0",
        "symfony/web-profiler-bundle": "^7.4||^8.0",
        "spryker/code-sniffer": "^0.17.2"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    }
}
