parameters:
  level: 6
  paths:
    - src
  ignoreErrors:
    # methods of generated model, query and table map classes
    -
      identifier: method.notFound
      message: '#^Call to an undefined method Propel\\Runtime\\(ActiveRecord\\ActiveRecordInterface|ActiveQuery\\ModelCriteria|Map\\TableMap)(&\S+)?::#'
    # its replacement is only available as of Symfony 8.1
    -
      message: '#deprecated interface Symfony\\Component\\HttpKernel\\Bundle\\BundleInterface#'
      reportUnmatched: false
    # Perpl aliases Propel to Perpl, which PHPStan does not follow; the bundle keeps Propel to support propel/propel
    -
      message: '#(on deprecated class|undefined (static method|constant)) Propel\\Runtime\\Propel\b#'
      reportUnmatched: false
    # Perpl deprecates these, but their replacements are missing in propel/propel
    -
      message: '#^Call to deprecated method (getClassName|isUseIdGenerator|joinWith)\(\) of class Propel\\#'
      reportUnmatched: false
    # one branch is unreachable, depending on whether propel/propel or Perpl is installed
    -
      path: src/Util/ColumnTypeName.php
      identifiers: [function.alreadyNarrowedType, function.impossibleType, method.notFound]
      reportUnmatched: false
    # MessageDecodingFailedException::wrap() exists as of Symfony 8.0; the other branch serves Symfony 7.4
    -
      path: src/Messenger/Transport/PropelTransport.php
      identifier: function.alreadyNarrowedType
      reportUnmatched: false
